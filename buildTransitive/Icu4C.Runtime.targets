<Project>

  <PropertyGroup>
    <_IcuSupportedRids>linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;win-x64;win-arm64;osx-x64;osx-arm64</_IcuSupportedRids>

    <!-- 求值期确定原生库目录；NormalizeDirectory 保证跨平台分隔符 -->
    <_IcuNativeDir Condition="'$(RuntimeIdentifier)' != ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..', 'runtimes', '$(RuntimeIdentifier)', 'native'))</_IcuNativeDir>

    <!-- 单一事实来源：打包时按实际构建的 ICU 版本注入（勿与包版本漂移） -->
    <_IcuVersion Condition="'$(_IcuVersion)' == ''">77.1</_IcuVersion>
    <_IcuVersionMajor>$([System.Text.RegularExpressions.Regex]::Match('$(_IcuVersion)', '^\d+').Value)</_IcuVersionMajor>
  </PropertyGroup>

  <!-- 求值期注入 AppLocalIcu：JIT 与 NativeAOT 均生效
       （AOT 由 ILC 在 WriteIlcRspFileForCompilation 读取该 item 并编入可执行文件） -->
  <ItemGroup Condition="'$(_IcuVersion)' != ''">
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="$(_IcuVersion)" />
    <RuntimeHostConfigurationOption Include="System.Globalization.UseNls" Value="false" />
  </ItemGroup>

  <PropertyGroup>
    <!-- 不覆盖用户显式设置 -->
    <InvariantGlobalization Condition="'$(InvariantGlobalization)' == ''">false</InvariantGlobalization>
  </PropertyGroup>

  <!-- 扫描实际文件名，仅用于一致性校验告警 -->
  <UsingTask TaskName="GetIcuVersion" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <NativeDir ParameterType="System.String" Required="false" />
      <IcuVersion ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        IcuVersion = "";
        if (!string.IsNullOrEmpty(NativeDir) && Directory.Exists(NativeDir)) {
          // 统一取「主版本」用于对比
          foreach (var f in Directory.GetFiles(NativeDir, "libicuuc.so.*")) {
            var m = Regex.Match(Path.GetFileName(f), @"^libicuuc\.so\.(\d+)");
            if (m.Success) { IcuVersion = m.Groups[1].Value; break; }
          }
          if (IcuVersion.Length == 0) {
            foreach (var f in Directory.GetFiles(NativeDir, "icuuc*.dll")) {
              var m = Regex.Match(Path.GetFileName(f), @"^icuuc(\d+)\.dll$");
              if (m.Success) { IcuVersion = m.Groups[1].Value; break; }
            }
          }
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="_IcuValidate" BeforeTargets="PrepareForBuild">
    <Warning Condition="'$(RuntimeIdentifier)' != '' And !$(_IcuSupportedRids.Contains('$(RuntimeIdentifier)'))"
             Text="ICU4C001: Icu4C.Runtime 未覆盖 RID '$(RuntimeIdentifier)'。支持: $(_IcuSupportedRids)。" />
    <Warning Condition="'$(InvariantGlobalization)' == 'true'"
             Text="ICU4C003: InvariantGlobalization=true 与 Icu4C.Runtime 冲突，ICU 不会启用。" />

    <GetIcuVersion Condition="'$(_IcuNativeDir)' != ''" NativeDir="$(_IcuNativeDir)">
      <Output TaskParameter="IcuVersion" PropertyName="_IcuScannedVersion" />
    </GetIcuVersion>

    <Warning Condition="'$(RuntimeIdentifier)' != '' and '$(_IcuScannedVersion)' == ''"
             Text="ICU4C002: 未在 '$(_IcuNativeDir)' 找到 ICU 原生库。" />
    <Warning Condition="'$(_IcuScannedVersion)' != '' and '$(_IcuScannedVersion)' != '$(_IcuVersionMajor)'"
             Text="ICU4C004: 原生库主版本 '$(_IcuScannedVersion)' 与声明版本 '$(_IcuVersion)' 不一致。" />
  </Target>

  <!-- AOT：复制到发布根目录，供 AppLocalIcu 经 ApplicationDirectory 加载 -->
  <ItemGroup Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">
    <None Include="$(_IcuNativeDir)*"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Link="%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- rpath 用单 $（不是 $$） -->
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <LinkerArg Include="-Wl,-rpath,'$ORIGIN'" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <LinkerArg Include="-Wl,-rpath,'@executable_path'" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
  </ItemGroup>

</Project>
