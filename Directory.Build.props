<Project>

  <PropertyGroup>
    <!-- Single source of truth for the NuGet package version.
         Scheme: <icu-major>.<icu-minor>.<base>  plus an optional 4th "revision" part for
         bugfix / repack releases of the SAME ICU version:
             ICU 77.1 first release : 77.1.0
             then small fixes       : 77.1.0.1, 77.1.0.2, ...
         Notes:
           - NuGet supports 4-part versions (Major.Minor.Patch.Revision).
           - Do NOT use a zero 4th part: 77.1.0.0 normalizes to 77.1.0.
           - The ICU version used for AppLocalIcu stays independent (build*/Icu4C.Runtime.targets). -->
    <IcuPackageVersion Condition="'$(IcuPackageVersion)' == ''">77.1.0</IcuPackageVersion>
  </PropertyGroup>

</Project>
