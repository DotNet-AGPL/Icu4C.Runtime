<Project>

  <PropertyGroup>
    <!-- Single source of truth for the NuGet package version.
         Scheme: <icu-major>.<icu-minor>.<revision> — the first two parts track the ICU
         version, the third is the packaging revision (starts at 1):
             ICU 77.1 line      : 77.1.1, 77.1.2, ..., 77.1.6
             ICU 78.3 line      : 78.3.1
             ICU 79.1 release 1 : 79.1.1
             then fixes         : 79.1.2, 79.1.3, ...
         Notes:
           - The ICU shared library keeps its own version (79.1 -> libicu*.so.79.1); the package
             version does NOT change the .so name.
           - The ICU version used for AppLocalIcu stays independent (in the package targets). -->
    <IcuPackageVersion Condition="'$(IcuPackageVersion)' == ''">79.1.1</IcuPackageVersion>
  </PropertyGroup>

</Project>
